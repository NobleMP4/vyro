# Copy to .env — never commit the real file.

# Must match the credentials in the root docker-compose.yml / .env
DATABASE_URL=mysql://vyro:vyro@localhost:3306/vyro

# Long random strings (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET=
JWT_REFRESH_SECRET=

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173
