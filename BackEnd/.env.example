# Copy to .env — never commit the real file.

# ── Database (MySQL 8) ──────────────────────────────────────────
# Address of your MySQL server: the docker-compose container (localhost),
# an existing container/server on your network (e.g. 192.168.1.20),
# or a container name if the API runs in the same Docker network.
DB_HOST=localhost
DB_PORT=3306
DB_USER=vyro
DB_PASSWORD=vyro
DB_NAME=vyro

# Alternative: a full connection string (takes precedence over DB_* when set).
# Special characters in the password must then be URL-encoded.
# DATABASE_URL=mysql://user:password@host:3306/vyro

# ── Auth ────────────────────────────────────────────────────────
# REQUIRED: two different long random strings (≥ 32 chars), e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_REFRESH_SECRET=

# Max attempts per minute per IP on login/register/password routes (default 10)
# AUTH_RATE_LIMIT=10
# Set to true when running behind a reverse proxy (real client IP for rate limiting)
# TRUST_PROXY=false

# ── Email (password reset) ──────────────────────────────────────
# Without SMTP_HOST, emails are not sent: in development the reset link is printed in the API logs.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=VYRO <no-reply@example.com>

# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173
